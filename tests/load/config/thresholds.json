{
  "description": "Test-health thresholds — not product SLAs. Primary gates use semantic_success / unexpected_status, not raw http_req_failed alone.",
  "global": {
    "unexpected_status": ["rate<0.02"],
    "semantic_success": ["rate>0.98"],
    "http_req_failed": ["rate<0.02"],
    "http_req_duration": ["p(95)<3000", "p(99)<8000"],
    "checks": ["rate>0.95"]
  },
  "groups": {
    "home": {
      "http_req_duration": ["p(95)<4000"]
    },
    "personalized": {
      "http_req_duration": ["p(95)<5000"]
    },
    "movie-detail": {
      "http_req_duration": ["p(95)<3500"]
    },
    "detail-status": {
      "http_req_duration": ["p(95)<2500"]
    },
    "library": {
      "http_req_duration": ["p(95)<5000"]
    },
    "insights": {
      "http_req_duration": ["p(95)<8000"]
    },
    "search": {
      "http_req_duration": ["p(95)<4000"]
    },
    "discover": {
      "http_req_duration": ["p(95)<4000"]
    },
    "external-ratings-warm": {
      "http_req_duration": ["p(95)<3000"]
    },
    "saturation-discovery": {
      "http_req_duration": ["p(95)<3000"]
    },
    "saturation-catalog": {
      "http_req_duration": ["p(95)<3000"]
    }
  },
  "names": {
    "tv-detail": {
      "http_req_duration": ["p(95)<3500"]
    },
    "tv-season-1": {
      "http_req_duration": ["p(95)<3500"],
      "abortOnFail": false
    },
    "discover": {
      "http_req_duration": ["p(95)<4000"],
      "abortOnFail": false
    },
    "explore-preview": {
      "http_req_duration": ["p(95)<4000"],
      "abortOnFail": false
    },
    "personalized": {
      "http_req_duration": ["p(95)<5000"],
      "abortOnFail": false
    },
    "recommendations-home": {
      "http_req_duration": ["p(95)<5000"],
      "abortOnFail": false
    }
  },
  "applicationScoped": {
    "http_req_duration{workload_scope:application}": ["p(95)<3000", "p(99)<8000"],
    "http_reqs{workload_scope:application}": ["count>0"]
  },
  "abortSignals": {
    "unexpected_status_rate": 0.05,
    "http_req_duration_p99_ms": 15000,
    "latency_multiplier_vs_baseline": 2.5,
    "latency_multiplier_vs_previous_healthy_stage": 2.0,
    "notes": "Hard limits are emergency backstops. Stop on sustained baseline-relative regression even if p99<15s."
  }
}
