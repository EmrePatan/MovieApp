# Copy to .env (gitignored) for local operator convenience — never commit secrets.

LOAD_TEST_BASE_URL=https://api.example.com
LOAD_TEST_ENVIRONMENT=production
LOAD_TEST_TOKENS_FILE=./data/tokens.json
LOAD_TEST_CONTENT_DATASET=hot
LOAD_TEST_PRESET=smoke
LOAD_TEST_STAGE_TARGET=50
LOAD_TEST_INCLUDE_EXTERNAL_RATINGS=false
LOAD_TEST_SEARCH_PROFILE=autocomplete-only
LOAD_TEST_HTTP_TIMEOUT_MS=30000
LOAD_TEST_ACCEPT_LANGUAGE=en-US

# Grafana Secrets sync (operator machine only — never commit values)
# GRAFANA_URL=https://your-stack.grafana.net
# GRAFANA_SA_TOKEN=
