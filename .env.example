# Copy this file to .env and set values for local Docker Compose development.
# .env is ignored by git and must not be committed.

POSTGRES_USER=movieapp
POSTGRES_PASSWORD=your-local-development-password
POSTGRES_DB=movieapp

# ASP.NET Core reads this when running the API locally.
# Must match POSTGRES_PASSWORD above.
PostgreSql__Password=your-local-development-password

# Optional component-based PostgreSQL settings (local dotnet run defaults from appsettings.Development.json)
# PostgreSql__Host=localhost
# PostgreSql__Port=5432
# PostgreSql__Database=movieapp
# PostgreSql__Username=movieapp

# Local Redis (docker-compose redis service)
# Redis__ConnectionString=localhost:6379
# Redis__InstanceName=MovieApp:

# Movie provider selection: Fake (default) or Tmdb
MovieProviders__Provider=Fake

# TMDB credentials (use only with a properly licensed TMDB account for commercial use)
# Prefer ReadAccessToken (bearer) when available; ApiKey is supported as a fallback.
MovieProviders__Tmdb__ReadAccessToken=
MovieProviders__Tmdb__ApiKey=

# JWT signing key for local authentication (never commit real secrets)
Authentication__Jwt__SigningKey=

# Optional: run the API container locally against docker-compose infrastructure
# docker compose -f docker-compose.api.yml up --build
# Container listens on http://localhost:8080
# Required when using docker-compose.api.yml:
# Authentication__Jwt__SigningKey=<local-dev-key-at-least-32-chars>
#
# Production/container secrets are supplied via environment variables at deploy time.
# MovieApp does NOT use ConnectionStrings__DefaultConnection.
#
# PostgreSQL (prefer full connection string in production):
# PostgreSql__ConnectionString=Host=...;Port=5432;Database=movieapp;Username=...;Password=...;SSL Mode=Require
# Or component-based:
# PostgreSql__Host=...
# PostgreSql__Port=5432
# PostgreSql__Database=movieapp
# PostgreSql__Username=...
# PostgreSql__Password=...
#
# Redis (managed provider; include password/TLS params in connection string when required):
# Redis__ConnectionString=...
# Redis__InstanceName=MovieApp:
#
# Auth / catalog / email:
# Authentication__Jwt__SigningKey=...
# MovieProviders__Provider=Tmdb
# MovieProviders__Tmdb__ReadAccessToken=...
# Authentication__PasswordReset__EmailProvider=Smtp
# Authentication__PasswordReset__BaseUrl=movieapp://reset-password
# Authentication__Email__Smtp__Host=...
# Authentication__Email__Smtp__Username=...
# Authentication__Email__Smtp__Password=...
#
# See docs/PRODUCTION_DATABASE_RUNBOOK.md for migration and backup procedures.
