{
  "ForwardedHeaders": {
    "Enabled": true,
    "UseRenderProxyTrustDefaults": true
  },
  "BackgroundJobs": {
    "Enabled": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    }
  }
}
