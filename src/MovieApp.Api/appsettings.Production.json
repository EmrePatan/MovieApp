{
  "ForwardedHeaders": {
    "Enabled": true,
    "UseRenderProxyTrustDefaults": true
  },
  "Authentication": {
    "PasswordReset": {
      "EmailProvider": "Resend",
      "BaseUrl": "https://moviecaveapp.com/auth/reset-password"
    },
    "EmailVerification": {
      "BaseUrl": "https://moviecaveapp.com/auth/verify-email"
    },
    "Email": {
      "Resend": {
        "FromAddress": "noreply@moviecaveapp.com",
        "FromName": "Movie Cave"
      }
    }
  },
  "BackgroundJobs": {
    "Enabled": true
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Formatting.Compact" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Hangfire": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  }
}
