{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "PostgreSql": {
    "Host": "localhost",
    "Port": 5432,
    "Database": "movieapp",
    "Username": "movieapp"
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "MovieApp:"
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "MovieApp",
      "Audience": "MovieApp.Mobile",
      "SigningKey": "",
      "AccessTokenMinutes": 60
    }
  },
  "MovieProviders": {
    "Provider": "Fake",
    "Tmdb": {
      "BaseUrl": "https://api.themoviedb.org/3/",
      "ApiKey": "",
      "ReadAccessToken": ""
    },
    "Tvdb": {
      "BaseUrl": "https://api4.thetvdb.com/v4/",
      "ApiKey": ""
    }
  }
}
